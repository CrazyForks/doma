{
    "name": "__MSG_extension_name__",
    "version": "2.9.8",
    "description": "__MSG_extension_description__",
    "manifest_version": 3,
    "build" : "234",
    "copyright": "Stay Browser",
    "default_locale": "en",

    "icons":{
        "48": "extension-img/icon-48-chrome.png",
        "96": "extension-img/icon-96-chrome.png",
        "128": "extension-img/icon-128-chrome.png",
        "256": "extension-img/icon-256-chrome.png"
    },

    "host_permissions": [
        "<all_urls>"
    ],

    "background":{
        "scripts": ["service/service-worker.js"]
    },

    "content_scripts": [
        {
            "js": ["source/inject/heartbeat.js"],
            "matches": [ "<all_urls>" ],
            "all_frames": false,
            "run_at": "document_start"
        },
        {
            "js": ["source/inject/tag.js"],
            "matches": [ "<all_urls>" ],
            "all_frames": true,
            "run_at": "document_start"
        },
        {
            "js": ["source/inject/observer.js"],
            "matches": [ "<all_urls>" ],
            "all_frames": false,
            "run_at": "document_start"
        },
        {
            "js": ["source/dark/fallback.js", "source/dark/dark.config.js", "source/dark/dark.user.js"],
            "matches": [ "<all_urls>" ],
            "all_frames": true,
            "run_at": "document_start"
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "source/dark/proxy.js"
            ],
            "run_at": "document_start",
            "all_frames": true,
            "match_about_blank": true
        },
        {
            "js": ["source/lib/jszip.min.js"],
            "matches": [ "<all_urls>" ],
            "all_frames": false,
            "run_at": "document_start"
        },
        {
            "js": ["source/downloader/file/parse.file.js"],
            "matches": [ "<all_urls>" ],
            "all_frames": true,
            "run_at": "document_start"
        },
        {
            "js": ["source/downloader/image/parse.image.js"],
            "matches": [ "<all_urls>" ],
            "all_frames": true,
            "run_at": "document_start"
        },
        {
            "js": ["source/blocker/adblocker.user.js"],
            "matches": [ "<all_urls>" ],
            "all_frames": true,
            "run_at": "document_start"
        },
        {
            "js": ["source/inject/miniapp.js"],
            "matches": [ "<all_urls>" ],
            "all_frames": false,
            "run_at": "document_start"
        },
        {
            "js": ["source/inject/install-script.js"],
            "matches": [ "*://greasyfork.org/*/scripts/*" ],
            "all_frames": false,
            "run_at": "document_start"
        },
        {
            "js": ["source/inject/official.bridge.js"],
            "matches": [ "*://staybrowser.com/*", "*://www.staybrowser.com/*" ],
            "all_frames": false,
            "run_at": "document_start"
        },
        {
            "js": ["source/inject/meta.user.js"],
            "matches": [ "<all_urls>" ],
            "all_frames": false,
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_icon": {
            "48": "extension-img/icon-48-chrome.png",
            "96": "extension-img/icon-96-chrome.png"
        },
        "default_title": "Stay",
        "default_popup": "popup/index.html#popup"
    },
    "sidebar_action": {
        "default_icon": {
            "48": "extension-img/icon-48-chrome.png",
            "96": "extension-img/icon-96-chrome.png"
        },
        "default_title": "Stay side pannel",
        "default_panel": "popup/index.html#sidepanel",
        "open_at_install":true
    },
    "options_page": "options/index.html",
    "web_accessible_resources": [{
        "resources": ["assets/*", "source/*"],
        "matches": ["<all_urls>"]
    }],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'"
    },
    "optional_host_permissions": [
        "<all_urls>"
    ],
    "optional_permissions": [
        "userScripts"
    ],
    "permissions": [
        "activeTab",
        "storage",
        "alarms",
        "tabs",
        "unlimitedStorage",
        "webNavigation",
        "downloads",
        "cookies",
        "bookmarks"
    ]
}