{
    "name": "__MSG_extension_name__",
    "version": "0.0.17",
    "description": "__MSG_extension_description__",
    "manifest_version": 3,
    "build": "274",
    "copyright": "DomA Agent",
    "default_locale": "en",
    "icons": {
        "48": "extension-img/icon-48.png",
        "96": "extension-img/icon-96.png",
        "128": "extension-img/icon-128.png",
        "256": "extension-img/icon-256.png"
    },
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "service/service-worker.js"
    },
    "content_scripts": [
        {
            "js": [
                "source/inject/web.assistant.user.js"
            ],
            "matches": [
                "<all_urls>"
            ],
            "all_frames": true,
            "run_at": "document_start"
        },
        {
            "js": [
                "source/inject/meta.user.js"
            ],
            "matches": [
                "<all_urls>"
            ],
            "all_frames": false,
            "run_at": "document_start"
        },
        {
            "js": [
                "source/inject/select.captrue.js"
            ],
            "matches": [
                "<all_urls>"
            ],
            "all_frames": true,
            "run_at": "document_start"
        },
        {
            "js": [
                "source/inject/screenshot.capture.js"
            ],
            "matches": [
                "<all_urls>"
            ],
            "all_frames": false,
            "run_at": "document_idle"
        }
    ],
    "side_panel": {
        "default_path": "popup/index.html#sidepannel"
    },
    "action": {},
    "web_accessible_resources": [
        {
            "resources": [
                "assets/*",
                "source/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
        "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval'; child-src 'self';"
    },
    "permissions": [
        "<all_urls>",
        "sidePanel",
        "activeTab",
        "storage",
        "alarms",
        "tabs",
        "tabGroups",
        "unlimitedStorage",
        "webNavigation",
        "cookies",
        "bookmarks",
        "windows",
        "userScripts",
        "scripting",
        "clipboardRead",
        "clipboardWrite",
        "notifications",
        "history",
        "debugger"
    ]
}
