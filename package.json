{
  "name": "doma",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "PolyForm-Shield-1.0.0",
  "description": "Conversation is action. The open-source version of DomA — an AI automation agent for the browser.",
  "scripts": {
    "clean": "rm -rf dist/",
    "sync:edition-ts": "node scripts/sync-edition-tsconfig.mjs",
    "dev:worker": "VITE_BUILD_EDITION=open npm run sync:edition-ts && BUILD_TYPE=dev VITE_BUILD_EDITION=open vite build -c inline-builder.ts --mode desktop-open --watch",
    "build:worker": "VITE_BUILD_EDITION=open npm run sync:edition-ts && BUILD_TYPE=pro VITE_BUILD_EDITION=open vite build -c inline-builder.ts --mode desktop-open",
    "desktop-dev": "VITE_BUILD_EDITION=open npm run sync:edition-ts && BUILD_TYPE=dev VITE_BUILD_EDITION=open vite build --mode desktop-open --watch",
    "desktop-build": "VITE_BUILD_EDITION=open npm run sync:edition-ts && BUILD_TYPE=pro VITE_BUILD_EDITION=open vite build --mode desktop-open",
    "dev": "npm run apply:open && VITE_BUILD_EDITION=open npm run sync:edition-ts && npm-run-all --parallel clean desktop-dev dev:worker",
    "dev:open": "npm run dev",
    "build": "npm run apply:open && VITE_BUILD_EDITION=open npm run sync:edition-ts && npm-run-all --sequential desktop-build build:worker",
    "build:open": "npm run build",
    "dev:firefox-worker": "BUILD_TYPE=dev vite build -c inline-builder.ts --mode desktop-firefox --watch",
    "build:firefox-worker": "BUILD_TYPE=pro vite build -c inline-builder.ts --mode desktop-firefox",
    "firefox-dev": "BUILD_TYPE=dev vite build --mode desktop-firefox --watch",
    "firefox-build": "BUILD_TYPE=pro vite build --mode desktop-firefox",
    "dev:firefox": "npm-run-all --parallel clean firefox-dev dev:firefox-worker",
    "build:firefox": "npm-run-all --sequential firefox-build build:firefox-worker",
    "preview": "vite preview",
    "postinstall": "npm run sync:edition-ts",
    "apply:pro": "node scripts/apply-pro-overlay.mjs",
    "apply:open": "node scripts/apply-open-overlay.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.5",
    "@imengyu/vue3-context-menu": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@simonwep/pickr": "^1.9.1",
    "codemirror": "^6.0.1",
    "dompurify": "^3.2.6",
    "html2canvas": "^1.4.1",
    "m3u8-parser": "^7.2.0",
    "marked": "^15.0.12",
    "platform": "^1.3.6",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/dompurify": "^3.0.5",
    "@types/less": "^3.0.8",
    "@types/m3u8-parser": "^7.2.5",
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/runtime-core": "^3.5.13",
    "@vue/tsconfig": "^0.7.0",
    "crypto-js": "^4.2.0",
    "less": "^4.2.2",
    "less-loader": "^12.2.0",
    "mime": "^4.1.0",
    "npm-run-all": "^4.1.5",
    "terser": "^5.27.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "tsx": "^4.19.3",
    "typescript": "~5.7.2",
    "vite": "^6.2.1",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-static-copy": "^2.3.0",
    "vite-svg-loader": "^5.1.0"
  }
}
